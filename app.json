{
  "expo": {
    "name": "ClosetAI",
    "owner": "gregparky",
    "slug": "closet-ai",
    "scheme": [
      "closetai",
      "com.googleusercontent.apps.1009777341636-1nmlmms9h1tn19ina5v2u8sglghhtfof"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gregpark.closetai",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "ClosetAI accesses your photo library so you can add clothing items to your closet.",
        "NSCameraUsageDescription": "ClosetAI uses your camera to photograph clothing items for your closet.",
        "NSLocationWhenInUseUsageDescription": "ClosetAI uses your location to show live weather and tailor outfit suggestions to the conditions outside."
      }
    },
    "android": {
      "package": "com.gregpark.closetai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "extra": {
      "google": {
        "webClientId": "626091187407-8jteapulfhpgt9j99nsgbdinec10ntfn.apps.googleusercontent.com",
        "iosClientId": "626091187407-hgvg7kb67n25mc97j5734kbarl3ofkdj.apps.googleusercontent.com",
        "androidClientId": "1009777341636-5q9i0an6rthkkliv8vvqmfk054uhrbmp.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "35d2bffd-4d76-44ba-a0fa-01d38467b360"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "ClosetAI accesses your photos to add clothing items to your closet.",
          "cameraPermission": "ClosetAI uses your camera to photograph clothing items."
        }
      ],
      "expo-asset"
    ],
    "newArchEnabled": true
  }
}
