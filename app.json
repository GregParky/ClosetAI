{
  "expo": {
    "name": "ClosetAI",
    "owner": "gregparky",
    "slug": "closet-ai",
    "scheme": "closetai",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gregpark.closetai"
    },
    "android": {
      "package": "com.gregpark.closetai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleWebClientId": "XXXXX.apps.googleusercontent.com",
      "googleIosClientId": "XXXXX.apps.googleusercontent.com",
      "googleAndroidClientId": "XXXXX.apps.googleusercontent.com"
    },
    "plugins": ["expo-web-browser"]
  }
}
